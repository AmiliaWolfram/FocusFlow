<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ff_background"
    android:padding="22dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TASKS"
        android:textColor="@color/ff_orange"
        android:textStyle="bold"
        android:letterSpacing="0.12" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Make progress,\none task at a time."
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/ff_text"
        android:layout_marginTop="10dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Plan your day and connect tasks to bigger goals."
        android:textColor="@color/ff_text_secondary"
        android:layout_marginTop="8dp" />
    <Button
        android:id="@+id/btnAddTask"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="+  ADD A TASK"
        android:textStyle="bold"
        android:textColor="@color/ff_white"
        android:backgroundTint="@color/ff_orange"
        android:layout_marginTop="24dp" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp" />
</LinearLayout>
