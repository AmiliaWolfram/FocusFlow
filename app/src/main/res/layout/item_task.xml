<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_soft_card"
    android:gravity="center_vertical"
    android:minHeight="92dp"
    android:orientation="horizontal"
    android:padding="16dp">
    <CheckBox
        android:id="@+id/cbCompleted"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:buttonTint="@color/ff_green" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/ff_text" />
        <TextView
            android:id="@+id/tvTaskCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/ff_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/tvTaskDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_green_chip"
        android:padding="10dp"
        android:textColor="@color/ff_green_dark"
        android:textStyle="bold" />
</LinearLayout>
